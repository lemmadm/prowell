          "_name": "footer01",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 fabm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Active Color\" value=\"#E0B548\" name=\"active\">\n        <input type=\"color\" title=\"Border Color\" value=\"#72716b\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#474A48\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div class=\"logo-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <a href=\"#\" class=\"logo-wrap\" mbr-if=\"showLogo\">\n                        <img src=\"@PROJECT_PATH@/assets/images/logoaow-200x195.png\" alt=\"Prowell\">\n                    </a>\n                    <div class=\"border-wrap\" mbr-if=\"showNav\"></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3\" mbr-if=\"showContacts || showTitle || showCopy\">\n                <div class=\"content-wrapper\">\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showContacts\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><a href=\"tel:+2348130490372\" class=\"text-primary\">+234 813 049 0372</a></li><a href=\"tel:+2348130490372\" class=\"text-primary\">\n                        </a><li class=\"item-wrap\"><a href=\"mailto:info@prowell.com.ng\" class=\"text-primary\">info@prowell.com.ng</a></li>\n                    </ul>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Mining Company</h2>\n                    <h2 class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2025 - All Rights Reserved\n                    </h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showNav\">\n                <ul class=\"list nav-list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                    <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-primary\">Home</a></li>\n                    <li class=\"item-wrap\"><a href=\"about.html\" class=\"text-primary\">About Us</a></li>\n                    <li class=\"item-wrap\"><a href=\"gallery.html\" class=\"text-primary\">Gallery</a></li>\n                    <li class=\"item-wrap\"><a href=\"offers.html\" class=\"text-primary\">Job Offer</a></li>\n                    <li class=\"item-wrap\"><a href=\"contact.html\" class=\"text-primary\">Contact</a></li>\n                </ul>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uFdHfucsvp",
          "_anchor": "footer01-1b",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        },
