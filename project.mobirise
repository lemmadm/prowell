            ".subtitle-wrap": {
              "display": "flex",
              "justify-content": "flex-end",
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".mbr-section-subtitle": {
                "padding": "32px",
                "writing-mode": "tb",
                "transform": "rotate(180deg)",
                "margin": "0",
                "@media (max-width: 992px)": {
                  "transform": "rotate(0)",
                  "writing-mode": "horizontal-tb",
                  "padding": "24px",
                  "border-left": "1px solid @border",
                  "text-align": "left"
                }
              }
            },
            ".content-wrapper": {
