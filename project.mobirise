        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".row": {
              "@media (min-width: 992px)": {
                "margin": "0"
              },
              ".card": {
                "border-top": "1px solid @border",
                "padding": "0",
                "border-radius": "0 !important",
                "@media (max-width: 992px)": {
                  "padding": "0 16px",
                  "border": "none"
                }
              }
            },
            ".content-wrapper": {
              "padding": "32px",
              "position": "sticky",
              "top": "0",
              "@media (max-width: 992px)": {
                "padding": "24px"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              },
              ".mbr-text": {
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              },
              ".mbr-section-btn": {
                "margin-top": "32px",
                "@media (max-width: 992px)": {
                  "text-align": "left",
                  "margin-top": "24px"
                }
              }
            },
            ".items": {
              "border-left": "1px solid @border",
              "& when (@reverseContent)": {
                "border-left": "none",
                "border-right": "1px solid @border"
              },
              "@media (max-width: 992px)": {
                "border-top": "1px solid @border"
              },
              ".item": {
                "padding": "32px",
                "border-bottom": "1px solid @border",
                "@media (max-width: 992px)": {
                  "padding": "24px"
                },
                "&:last-child": {
                  "border": "none"
                },
                ".item-wrapper": {
                  ".card-box": {
                    ".title-wrapper": {
                      "margin-bottom": "8px",
                      ".title-wrap": {
                        "display": "inline-flex",
                        ".card-title": {
                          "margin-bottom": "0"
                        },
                        ".card-number": {
                          "margin": "0 0 0 8px",
                          "min-width": "22px"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0"
            },
            ".mbr-text": {
              "color": "#F9F6E0",
              "text-align": "right"
            },
            ".card-title": {
              "color": "#F9F6E0"
            },
            ".card-number": {
              "color": "#E0B548"
            },
            ".card-text": {
              "color": "#F9F6E0"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "right"
            }
