                "padding": "24px",
                "border-top": "none"
              },
              "img": {
                "height": "350px",
                "object-fit": "cover"
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0"
            },
            ".mbr-section-subtitle": {
              "color": "#F9F6E0",
              "text-align": "right"
            },
            ".mbr-text": {
              "color": "#F9F6E0",
              "text-align": "right"
            },
            ".card-title": {
              "color": "#F9F6E0"
            },
            ".card-text": {
              "color": "#F9F6E0"
            }
