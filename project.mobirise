              "position": "sticky",
              "top": "0",
              "@media (max-width: 992px)": {
                "padding": "24px",
                "border": "none"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              },
              ".mbr-text": {
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              }
            },
            ".items": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "border-left": "1px solid @border",
              "& when (@reverseContent)": {
                "border-left": "none",
                "border-right": "1px solid @border"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".item": {
                "padding": "32px",
                "border-top": "1px solid @border",
                "border-right": "1px solid @border",
                "&:nth-child(2n)": {
                  "border-right": "none"
                },
                "@media (max-width: 992px)": {
                  "padding": "24px",
                  "border-right": "none !important"
                },
                ".item-wrapper": {
                  ".card-box": {
                    ".card-title": {
                      "margin-bottom": "8px"
                    },
                    ".card-text": {
                      "margin-bottom": "0"
                    },
                    ".mbr-section-btn": {
                      "margin-top": "32px",
                      "@media (max-width: 992px)": {
                        "margin-top": "24px"
                      }
                    },
                    ".contact-wrap": {
                      "margin-bottom": "16px",
                      "&:last-child": {
                        "margin-bottom": "0"
                      },
                      ".card-title": {
                        "margin-bottom": "8px"
                      },
                      ".card-text": {
                        "margin-bottom": "0"
                      },
                      ".list": {
                        "margin": "16px 0 0 0",
                        "padding": "0",
                        "list-style-type": "none",
                        ".item-wrap": {
                          "margin-bottom": "16px",
                          "transition": "all 0.3s ease-in-out",
                          "&:last-child": {
                            "margin-bottom": "0"
                          },
                          "&:hover, &:focus": {
                            "color": "@active"
                          }
                        }
                      },
                      ".link-wrap": {
                        "display": "block",
                        "&:hover, &:focus": {
                          ".card-link": {
                            "color": "@active"
                          }
                        },
                        ".card-link": {
                          "margin-bottom": "0",
                          "transition": "all 0.3s ease-in-out"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0",
              "text-align": "right"
            },
            ".mbr-text": {
              "color": "#F9F6E0",
              "text-align": "right"
            },
            ".card-title": {
              "color": "#F9F6E0"
            },
            ".list": {
              "color": "#E0B548"
