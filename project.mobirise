            },
            ".content-wrapper": {
              "padding": "32px",
              "border-bottom": "1px solid @border",
              "@media (max-width: 992px)": {
                "padding": "24px"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
