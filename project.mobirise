        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".row": {
              "@media (min-width: 992px)": {
                "margin": "0"
              },
              ".card": {
                "padding": "0",
                "border-radius": "0 !important",
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".content-wrapper": {
              "border-top": "1px solid @border",
              "padding": "32px",
              "position": "sticky",
              "top": "0",
              "@media (max-width: 992px)": {
                "padding": "24px",
                "border": "none"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              },
              ".mbr-text": {
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              }
            },
            ".items": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "border-left": "1px solid @border",
              "& when (@reverseContent)": {
                "border-left": "none",
                "border-right": "1px solid @border"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".item": {
                "padding": "32px",
                "border-top": "1px solid @border",
                "border-right": "1px solid @border",
                "&:nth-child(2n)": {
                  "border-right": "none"
                },
                "@media (max-width: 992px)": {
                  "padding": "24px",
                  "border-right": "none !important"
                },
                ".item-wrapper": {
                  ".card-box": {
                    ".card-title": {
                      "margin-bottom": "8px"
                    },
                    ".card-text": {
                      "margin-bottom": "0"
                    },
                    ".mbr-section-btn": {
                      "margin-top": "32px",
                      "@media (max-width: 992px)": {
                        "margin-top": "24px"
                      }
                    },
                    ".contact-wrap": {
                      "margin-bottom": "16px",
                      "&:last-child": {
                        "margin-bottom": "0"
                      },
                      ".card-title": {
                        "margin-bottom": "8px"
                      },
                      ".card-text": {
                        "margin-bottom": "0"
                      },
                      ".list": {
                        "margin": "16px 0 0 0",
                        "padding": "0",
                        "list-style-type": "none",
                        ".item-wrap": {
                          "margin-bottom": "16px",
                          "transition": "all 0.3s ease-in-out",
                          "&:last-child": {
                            "margin-bottom": "0"
                          },
                          "&:hover, &:focus": {
                            "color": "@active"
                          }
                        }
                      },
                      ".link-wrap": {
                        "display": "block",
                        "&:hover, &:focus": {
                          ".card-link": {
                            "color": "@active"
                          }
                        },
                        ".card-link": {
                          "margin-bottom": "0",
                          "transition": "all 0.3s ease-in-out"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0",
              "text-align": "right"
            },
            ".mbr-text": {
              "color": "#F9F6E0",
              "text-align": "right"
            },
