              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".main-row": {
              "margin": "0",
              ".card": {
                "padding": "0",
                "border-radius": "0 !important",
                "border-top": "1px solid @border",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              }
