                  }
                },
                ".form-check": {
                  "padding-left": "2.1em",
                  "margin-left": "48px",
                  "@media (max-width: 992px)": {
                    "margin-left": "24px"
                  },
                  ".form-check-input": {
                    "background-color": "@secondaryColor",
                    "border-color": "@secondaryColor"
                  }
                },
                "textarea": {
                  "min-height": "270px"
                }
              },
              ".mbr-section-btn": {
                "margin-top": "32px",
                "width": "100%",
                "@media (max-width: 992px)": {
                  "margin-top": "24px"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0",
              "text-align": "right"
            },
            ".mbr-text": {
              "color": "#F9F6E0",
              "text-align": "right"
            },
            "label": {
              "color": "#F9F6E0"
            }
          },
          "_name": "form01",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 fabm5\" group=\"Forms\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#72716b\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" selected=\"\" parallax=\"\">\n            <input type=\"color\" title=\"Color\" value=\"#474A48\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row main-row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-4 card\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Write to Us</b>\n                    </h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Kindly utilize the contact form provided below for all quotation requests or inquiries.\n                    </p>\n                </div>\n            </div>\n            <div mbr-form=\"\" class=\"col-12 col-lg-8 mbr-form card form-wrapper\">\n<!--Formbuilder Form-->\n<form action=\"prowelloa@gmail.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert=\"\" class=\"alert alert-success col-12\">Thanks for filling out the form!</div>\n<div hidden=\"hidden\" data-form-alert-danger=\"\" class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3 \" data-for=\"name\">\n<input type=\"text\" name=\"name\" placeholder=\"Name*\" data-form-field=\"name\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value=\"\">\n</div>\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email\">\n<input type=\"email\" name=\"email\" placeholder=\"Email*\" data-form-field=\"email\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"number\" class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\">\n<input type=\"number\" name=\"number\" placeholder=\"Phone*\" data-form-field=\"number\" mbr-theme-style=\"display-7\" class=\"form-control\" max=\"100\" min=\"0\" step=\"1\" required=\"required\" value=\"\">\n</div>\n<div data-for=\"text\" class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\">\n<input type=\"text\" name=\"text\" placeholder=\"Location\" data-form-field=\"text\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"radio\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<div class=\"form-control-label\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"radio\" class=\"mbr-fonts-style\">How should we reach you:</label>\n</div>\n<div class=\"form-check form-check-inline ms-2\">\n<input type=\"radio\" name=\"radio\" data-form-field=\"radio\" mbr-theme-style=\"display-7\" class=\"form-check-input\" value=\"Email\" checked=\"checked\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" class=\"form-check-label\">Email</label>\n</div>\n<div class=\"form-check form-check-inline ms-2\">\n<input type=\"radio\" name=\"radio\" data-form-field=\"radio\" mbr-theme-style=\"display-7\" class=\"form-check-input\" value=\"Phone\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" class=\"form-check-label\">Phone</label>\n</div>\n<div class=\"form-check form-check-inline ms-2\">\n<input type=\"radio\" name=\"radio\" data-form-field=\"radio\" mbr-theme-style=\"display-7\" class=\"form-check-input\" value=\"Message\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" class=\"form-check-label\">Message</label>\n</div>\n</div>\n<div data-for=\"textarea1\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<textarea name=\"textarea1\" placeholder=\"Message*\" data-form-field=\"textarea\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n</div>\n<div class=\"col-md-auto col mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 w-100 btn btn-danger\"> SEND NOW </a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n        </div>\n    </div>\n</section>",
          "_cid": "uFdH48UFhL",
          "_anchor": "form01-9",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".row": {
              "justify-content": "space-between",
              "& when not (@showNav)": {
                "justify-content": "center"
              }
            },
            ".logo-wrapper": {
              "display": "flex",
              "& when not (@showNav)": {
                "justify-content": "center"
              },
              ".logo-wrap": {
                "img": {
                  "width": "100px",
                  "height": "100px",
                  "object-fit": "cover",
                  "border-radius": "5px !important"
                }
              },
              ".border-wrap": {
                "width": "100%",
                "border-bottom": "1px solid @border"
              }
            },
            ".content-wrapper": {
              "padding": "32px 0 0 32px",
              "& when (@reverseContent)": {
                "padding": "32px 32px 0 0",
                "@media (max-width: 992px)": {
                  "padding": "24px 0"
                }
              },
              "@media (max-width: 992px)": {
                "padding": "24px 0"
              },
              ".list": {
                "margin-bottom": "24px",
                "padding": "0",
                "list-style-type": "none",
                "line-height": "1.5",
                ".item-wrap": {
                  "margin-bottom": "8px",
                  "transition": "all 0.3s ease-in-out",
                  "&:hover, &:focus": {
                    "color": "@active"
                  },
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "24px"
              },
              ".mbr-copy": {
                "margin-bottom": "0",
                "line-height": "1.5"
              }
            },
            ".nav-list": {
              "padding": "0 32px 0 0",
              "line-height": "1.5",
              "list-style-type": "none",
              "margin": "0",
              "& when (@reverseContent)": {
                "padding": "0 0 0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              ".item-wrap": {
                "position": "relative",
                "border-left": "1px solid @border",
                "border-bottom": "1px solid @border",
                "padding": "12px 32px",
                "transition": "all 0.3s ease-in-out",
                "& when (@reverseContent)": {
                  "border-left": "none",
                  "border-right": "1px solid @border"
                },
                "&:hover, &:focus": {
                  "color": "@active",
                  "&::before": {
                    "opacity": "1"
                  }
                },
                "&:last-child": {
                  "border-bottom": "none"
                },
                "&::before": {
                  "content": "''",
                  "background-color": "@active",
                  "width": "6px",
                  "height": "6px",
                  "border-radius": "50%",
                  "position": "absolute",
                  "top": "45%",
                  "left": "13px",
                  "transition": "all 0.3s ease-in-out",
                  "opacity": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0"
            },
            ".list": {
              "color": "#F9F6E0"
            },
            ".mbr-copy": {
              "color": "#F9F6E0"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 fabm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Active Color\" value=\"#E0B548\" name=\"active\">\n        <input type=\"color\" title=\"Border Color\" value=\"#72716b\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#474A48\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div class=\"logo-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <a href=\"#\" class=\"logo-wrap\" mbr-if=\"showLogo\">\n                        <img src=\"@PROJECT_PATH@/assets/images/logoaow-200x195.png\" alt=\"Prowell\">\n                    </a>\n                    <div class=\"border-wrap\" mbr-if=\"showNav\"></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3\" mbr-if=\"showContacts || showTitle || showCopy\">\n                <div class=\"content-wrapper\">\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showContacts\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><a href=\"tel:+2348130490372\" class=\"text-primary\">+234 813 049 0372</a></li><a href=\"tel:+2348130490372\" class=\"text-primary\">\n                        </a><li class=\"item-wrap\"><a href=\"mailto:info@prowell.com.ng\" class=\"text-primary\">info@prowell.com.ng</a></li>\n                    </ul>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Mining Company</h2>\n                    <h2 class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2025 - All Rights Reserved\n                    </h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showNav\">\n                <ul class=\"list nav-list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                    <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-primary\">Home</a></li>\n                    <li class=\"item-wrap\"><a href=\"about.html\" class=\"text-primary\">About Us</a></li>\n                    <li class=\"item-wrap\"><a href=\"gallery.html\" class=\"text-primary\">Gallery</a></li>\n                    <li class=\"item-wrap\"><a href=\"offers.html\" class=\"text-primary\">Job Offer</a></li>\n                    <li class=\"item-wrap\"><a href=\"contact.html\" class=\"text-primary\">Contact</a></li>\n                </ul>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uFdH4feccl",
          "_anchor": "footer01-b",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "about.html": {
      "settings": {
        "title": "About Prowell Mining Nig Ltd",
        "meta_descr": "Learn about Prowell Mining Nig Ltd, a leading gold and tantalum mining company in Nigeria. Our vision is to drive sustainable resource development, environmental responsibility, and economic impact.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "2"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            ".navbar-dropdown": {
              "& when not (@transparent)": {
                "background-color": "@menuBgColor !important"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity) !important"
              },
              "padding": "0"
            },
            "background-color": "transparent",
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "& when not (@transparent)": {
                  "background-color": "@menuBgColor !important"
                },
                "& when (@transparent)": {
                  "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity) !important"
                },
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%"
                },
                "background": "@menuBgColor"
              }
            },
            ".menu_box": {
              "flex-wrap": "nowrap",
              "@media (max-width: 991px)": {
                ".navbar.opened, .navbar-collapse": {
                  "background-color": "@menuBgColor !important",
                  "transition": "all 0s ease 0s",
                  "& when (@transparent)": {
                    "background": "transparent !important"
                  }
                },
                "flex-direction": "column",
                "align-items": "flex-start"
              }
            },
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "nav.navbar": {
                "position": "fixed",
                "padding-top": "1rem",
                "padding-bottom": "1rem"
              }
            },
            "& when (@showSidebar)": {
              ".icons-menu-main": {
                "display": "none",
                "@media (max-width: 991px)": {
                  "max-width": "100%",
                  "margin": "1rem 0 1rem 1rem",
                  "display": "flex"
                }
              },
              ".mbr-section-btn-main": {
                "display": "none",
                "@media (max-width: 991px)": {
                  "margin-top": "1rem",
                  "display": "block"
                }
              }
            },
            "& when not (@showSidebar)": {
              ".icons-menu-main": {
                "display": "flex",
                "flex-wrap": "wrap",
                "min-width": "150px",
                "@media (max-width: 991px)": {
                  "min-width": "auto",
                  "max-width": "100%",
                  "margin": "1rem 0 1rem 1rem"
                }
              },
              ".mbr-section-btn-main": {
                "@media (max-width: 991px)": {
                  "margin-top": "1rem"
                }
              }
            },
            ".btn": {
              "min-height": "auto",
              "box-shadow": "none",
              "margin-top": "0",
              "&:hover": {
                "box-shadow": "none"
              }
            },
            "@media (min-width: 992px)": {
              ".offcanvas": {
                "padding": "12rem 64px 0",
                "width": "35%",
                "background-color": "@offSidebarColor"
              },
              ".offcanvas_image img": {
                "width": "auto",
                "object-fit": "cover",
                "display": "inline-block"
              },
              ".offcanvas-header": {
                "position": "relative",
                "padding": "0",
                ".btn-close": {
                  "position": "absolute",
                  "top": "-70px",
                  "right": "0",
                  "width": "35px",
                  "height": "30px"
                }
              },
              ".offcanvas-body": {
                "text-align": "center",
                "padding": "0",
                ".mbr-text, .mbr-section-subtitle": {
                  "margin-bottom": "32px"
                },
                ".offcanvas_contact": {
                  "margin": "0"
                }
              },
              ".offcanvas_box": {
                "button.btn_offcanvas": {
                  "outline": "none",
                  "width": "40px",
                  "height": "40px",
                  "cursor": "pointer",
                  "transition": "all 0.2s",
                  "position": "relative",
                  "align-self": "center",
                  ".hamburger span": {
                    "position": "absolute",
                    "right": "0",
                    "width": "40px",
                    "height": "2px",
                    "border-right": "5px",
                    "background-color": "@hamburgerColor",
                    "&:nth-child(1)": {
                      "top": "18px",
                      "transition": "all 0.2s"
                    },
                    "&:nth-child(2)": {
                      "top": "25px",
                      "transition": "all 0.2s"
                    }
                  },
                  "&:hover .hamburger span": {
                    "width": "36px",
                    "&:nth-child(2)": {
                      "width": "33px",
                      "transition-delay": "0.2s"
                    }
                  }
                }
              },
              "ul.navbar-nav": {
                "padding-bottom": "1.5rem"
              },
              ".dropdown-menu .dropdown-toggle[data-toggle=\"dropdown-submenu\"]::after, .link.dropdown-toggle::after": {
                "display": "inline-block",
                "width": "7px",
                "height": "7px",
                "margin-left": ".5rem",
                "margin-bottom": "2px",
                "content": "\"\"",
                "border": "2px solid",
                "border-left": "none",
                "border-top": "none",
                "transform": "rotate(-45deg)"
              },
              ".link.dropdown-toggle::after": {
                "padding": "0 !important",
